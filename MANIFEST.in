include README.md CONTRIBUTING.md SECURITY.md pyproject.toml requirements.txt .env.example .gitignore .gitattributes
recursive-include docs *.md
recursive-include scripts *.py *.ps1
recursive-include skills *.md *.yaml *.yml *.py
recursive-include excel_match_agent/tests *.py *.json
include examples/*.json
include examples/data/*.md examples/data/*.txt
include examples/data/sample.csv examples/data/gzk.json examples/data/excelrule.xlsx examples/data/name-rules.xlsx
recursive-include .github *.yml *.md
recursive-include .vscode *.json
global-exclude __pycache__ *.pyc *.log
